---
interface Props {
	date: string;
	title: string;
	description: string;
}

const { date, title, description } = Astro.props;
---

<div class="relative">
	<div class="absolute -left-[41px] top-0 w-4 h-4 bg-zinc-950 border-2 border-purple-600"></div>
	<div class="space-y-2">
		<div class="font-mono text-[10px] text-zinc-500 uppercase">{date}</div>
		<div class="bg-purple-600/5 border border-zinc-800 p-6 hover:bg-purple-600/10 transition-colors group">
			<h3 class="font-outfit text-xl uppercase mb-4 group-hover:text-purple-400 transition-colors">{title}</h3>
			<p class="font-mono text-xs text-zinc-400 leading-relaxed">{description}</p>
		</div>
	</div>
</div>
