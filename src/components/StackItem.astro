---
interface Props {
	label: string;
	title: string;
	active?: boolean;
}

const { label, title, active = false } = Astro.props;
---

<div class={`p-8 border border-zinc-800 flex flex-col gap-4 group transition-colors ${active ? 'bg-purple-600 text-white' : 'hover:bg-white/5'}`}>
	<span class={`font-mono text-[10px] uppercase ${active ? 'text-purple-200' : 'text-zinc-500'}`}>
		{label}
	</span>
	<span class="font-outfit text-2xl font-bold tracking-tighter uppercase">
		{title}
	</span>
</div>
