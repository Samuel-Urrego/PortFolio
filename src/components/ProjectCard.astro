---
interface Props {
	id: string;
	name: string;
	description: string;
	tags: string[];
	repoUrl: string;
	demoUrl?: string;
	image?: string;
	variant?: 'compact' | 'detailed';
}

const { id, name, description, tags, repoUrl, demoUrl, image, variant = 'detailed' } = Astro.props;
---

<div class={`bg-zinc-900/50 border border-zinc-800 overflow-hidden group transition-all duration-500 hover:border-purple-500/50 hover:shadow-[0_0_30px_-10px_rgba(168,85,247,0.2)] ${variant === 'detailed' ? 'shadow-[12px_12px_0px_0px_rgba(168,85,247,0.3)]' : 'shadow-[12px_12px_0px_0px_rgba(0,0,0,1)]'}`}>
	<div class={`${variant === 'detailed' ? 'bg-purple-600' : 'bg-zinc-800'} px-4 py-2 font-mono text-[10px] text-white uppercase font-bold group-hover:bg-purple-500 transition-colors`}>
		{id}: {name}
	</div>
	
	<div class={`p-6 ${variant === 'detailed' ? 'flex flex-col md:flex-row gap-6' : 'space-y-6'}`}>
		{variant === 'detailed' ? (
			<>
				<div class="flex-1 space-y-4">
					<p class="font-mono text-xs text-zinc-400 leading-relaxed">
						{description}
					</p>
					<div class="flex gap-4">
						<a href={repoUrl} class="flex-1 bg-black text-white font-mono text-[10px] py-2 border border-zinc-700 hover:bg-zinc-800 text-center">| REPO |</a>
						{demoUrl && <a href={demoUrl} class="flex-1 bg-white text-black font-mono text-[10px] py-2 border border-white hover:bg-zinc-200 text-center">| DEMO |</a>}
					</div>
				</div>
				<div class="w-full md:w-1/3 aspect-square bg-black border border-zinc-800 flex items-center justify-center relative overflow-hidden group-hover:border-purple-500/50 transition-colors">
					{image ? (
						<img src={image} alt={name} class="w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity duration-700" />
					) : (
						<div class="text-purple-600/30 font-mono text-[8px] overflow-hidden leading-none p-2 break-all opacity-50">
							{Array(200).fill(0).map(() => (Math.random() > 0.5 ? '1' : '0')).join('')}
						</div>
					)}
					<div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent opacity-60"></div>
				</div>
			</>
		) : (
			<>
				<div class="aspect-video bg-black border border-zinc-800 relative group overflow-hidden">
					<div class="absolute inset-0 bg-purple-600/10 group-hover:bg-purple-600/20 transition-colors z-10"></div>
					{image ? (
						<img src={image} alt={name} class="w-full h-full object-cover opacity-50 group-hover:opacity-100 transition-all duration-700 group-hover:scale-110" />
					) : (
						<div class="absolute inset-0 flex items-center justify-center opacity-30">
							<span class="font-mono text-xs text-purple-500">[ PREVIEW_IMG ]</span>
						</div>
					)}
					<div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent z-20"></div>
				</div>
				<div class="space-y-4">
					<div class="flex gap-2 flex-wrap">
						{tags.map(tag => (
							<span class="px-2 py-1 bg-zinc-800 text-[8px] font-mono text-zinc-400">{tag}</span>
						))}
					</div>
					<p class="font-mono text-xs text-zinc-400">"{description}"</p>
					<a href={repoUrl} class="block w-full bg-purple-600 text-white font-mono text-[10px] py-3 hover:bg-purple-500 uppercase tracking-widest font-bold text-center">| REPO |</a>
				</div>
			</>
		)}
	</div>
</div>
