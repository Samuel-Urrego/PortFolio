---
interface Props {
	id: string;
	title: string;
	icon?: 'shield' | 'none';
}

const { id, title, icon = 'shield' } = Astro.props;
---

<dialog 
	id={id} 
	class="bg-transparent backdrop:bg-black/80 backdrop:backdrop-blur-sm p-0 m-auto fixed inset-0 overflow-visible"
>
	<div class="bg-zinc-950 border-2 border-zinc-800 shadow-[24px_24px_0px_0px_rgba(0,0,0,0.5)] w-[calc(100%-2rem)] mx-auto md:w-full md:max-w-2xl max-h-[90vh] overflow-y-auto">
		<!-- Header -->
		<div class="bg-zinc-900 border-b-2 border-zinc-800 px-4 py-3 flex justify-between items-center">
			<div class="flex items-center gap-3 font-mono text-xs text-purple-400 uppercase font-bold tracking-widest">
				{icon === 'shield' && (
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
				)}
				{title}
			</div>
			<button 
				onclick={`document.getElementById('${id}').close()`}
				class="bg-zinc-100 text-black p-1 hover:bg-magenta-500 hover:text-white transition-colors"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
			</button>
		</div>
		
		<!-- Content -->
		<div class="p-4 md:p-8 space-y-8">
			<slot />
		</div>
	</div>
</dialog>

<script is:inline>
	// Handle click outside to close
	document.querySelectorAll('dialog').forEach(dialog => {
		dialog.addEventListener('click', (e) => {
			const dialogDimensions = dialog.getBoundingClientRect();
			if (
				e.clientX < dialogDimensions.left ||
				e.clientX > dialogDimensions.right ||
				e.clientY < dialogDimensions.top ||
				e.clientY > dialogDimensions.bottom
			) {
				dialog.close();
			}
		});
	});
</script>

<style>
	dialog[open] {
		animation: zoom 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	@keyframes zoom {
		from { transform: scale(0.95); opacity: 0; }
		to { transform: scale(1); opacity: 1; }
	}

	dialog::backdrop {
		animation: fade 0.2s ease-out;
	}

	@keyframes fade {
		from { opacity: 0; }
		to { opacity: 1; }
	}
</style>
