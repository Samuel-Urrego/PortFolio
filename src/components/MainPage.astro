---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StackItem from '../components/StackItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LogEntry from '../components/LogEntry.astro';
import Modal from '../components/Modal.astro';
import CredentialCard from '../components/CredentialCard.astro';

import { useTranslations, getLangFromUrl } from '../i18n/utils';
import { languages, projectsContent, logsContent, credentialsContent } from '../i18n/ui';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = projectsContent[lang];
const logs = logsContent[lang];
const credentials = credentialsContent[lang];
---

<Layout title={lang === 'en' ? "Backend Architect & AI Orchestrator" : "Arquitecto Backend & Orquestador IA"} lang={lang}>
	<!-- Hero Section -->
	<section class="py-12 md:py-32 flex flex-col items-start gap-6">
		<div class="font-mono text-[10px] md:text-xs text-purple-400 tracking-tighter animate-pulse">
			{t('hero.status')}
		</div>
		
		<h1 class="font-outfit text-5xl md:text-9xl leading-[0.8] uppercase font-extrabold text-purple-600 break-words w-full">
			<span class="scramble">{t('hero.title.backend')}</span><br/>
			<span class="scramble">{t('hero.title.architect')}</span> <span class="text-zinc-100">&</span><br/>
			<span class="scramble">{t('hero.title.orchestrator')}</span>
		</h1>
		
		<div class="flex flex-col md:flex-row items-start md:items-center gap-8 mt-4">
			<Button 
				label={t('hero.view_code')} 
				size="lg" 
				href="https://github.com/Samuel-Urrego" 
				class="shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] border-2 border-black"
			/>
			
			<div class="flex flex-col gap-4">
				<div class="max-w-xs font-mono text-sm text-zinc-500 bg-white/5 p-4 border-l-2 border-purple-600 italic">
					> {lang === 'en' 
					  ? '"Architect of the invisible. I design the logic that holds the digital world together while others only see the surface."'
					  : '"Arquitecto de lo invisible. Diseño la lógica que mantiene unido al mundo digital mientras otros solo ven la superficie."'
					}
				</div>
			</div>
		</div>
	</section>

	<!-- Core Stack -->
	<section id="stack" class="py-20 px-4 md:px-0">
		<SectionHeader title={t('section.stack')} accentColor="magenta" />
		
		<div class="grid grid-cols-2 md:grid-cols-6 gap-0 border border-zinc-800">
			<StackItem label="CORE" title="PYTHON" active />
			<StackItem label="CORE" title="C# / .NET" />
			<StackItem label="FRAMEWORKS" title="FASTAPI / BLAZOR" />
			<StackItem label="DATABASE" title="SQL SERVER" />
			<StackItem label="AI INTEGRATION" title="MCP PROTOCOL" />
			<StackItem label="ARCHITECTURE" title="CLEAN / SDD" />
		</div>
	</section>

	<!-- Deployed Logic -->
	<section id="projects" class="py-20 px-4 md:px-0">
		<SectionHeader title={t('section.projects')} align="right" />
		
		<div class="grid md:grid-cols-2 gap-12">
			{projects.map((project, index) => (
				<ProjectCard 
					id={project.id}
					name={project.name}
					description={project.description}
					tags={project.tags}
					repoUrl={project.repoUrl}
					demoUrl={project.demoUrl}
					image={project.image}
					variant={index < 2 ? 'detailed' : 'compact'}
				/>
			))}
		</div>
	</section>

	<!-- Logic Log -->
	<section id="log" class="py-20 px-4 md:px-0">
		<SectionHeader title={t('section.log')} />
		
		<div class="space-y-12 border-l-2 border-purple-600/30 pl-8 ml-4">
			{logs.map(log => (
				<LogEntry 
					date={log.date}
					title={log.title}
					description={log.description}
				/>
			))}
		</div>
		
		<div class="mt-16 flex justify-center">
			<button 
				onclick="document.getElementById('credentials-modal').showModal()"
				class="font-outfit text-xs tracking-widest uppercase text-purple-400 hover:text-purple-300 border-b border-purple-400/30 pb-1 transition-all"
			>
				{t('log.view_credentials')}
			</button>
		</div>
	</section>

	<!-- Modals -->
	<Modal id="credentials-modal" title="SYSTEM_CREDENTIALS.EXE">
		<div class="font-mono text-xs text-zinc-500 mb-4 uppercase">
			{t('modal.warning')}
		</div>
		{credentials.map(cred => (
			<CredentialCard 
				title={cred.title}
				institution={cred.institution}
				tags={cred.tags}
				actionLabel={cred.actionLabel}
				actionUrl={cred.actionUrl}
			/>
		))}
	</Modal>
</Layout>

<style>
	h1 {
		/* Fix for "miter peaks" / strange triangles in characters like '&' */
		text-shadow: 
			-1px -1px 0 rgba(168, 85, 247, 0.2),  
			 1px -1px 0 rgba(168, 85, 247, 0.2),
			-1px  1px 0 rgba(168, 85, 247, 0.2),
			 1px  1px 0 rgba(168, 85, 247, 0.2);
	}
	
	@media (min-width: 768px) {
		h1 {
			text-shadow: 
				-2px -2px 0 rgba(168, 85, 247, 0.2),  
				 2px -2px 0 rgba(168, 85, 247, 0.2),
				-2px  2px 0 rgba(168, 85, 247, 0.2),
				 2px  2px 0 rgba(168, 85, 247, 0.2);
		}
	}
</style>
